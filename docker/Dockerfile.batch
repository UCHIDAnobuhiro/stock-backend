FROM golang:1.27.2-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# バッチ統合（job_id 引数で candles / logo / auth-session-cleanup を切替）
RUN CGO_ENABLED=0 GOOS=linux go build -o batch ./cmd/batch

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app

ENV TZ=Asia/Tokyo

COPY --from=builder /app/batch .
USER nonroot

# デフォルトは candles（株価）。単一のCloud Run Job / composeからjob_idをargsで渡して切り替える。
ENTRYPOINT ["./batch"]
CMD ["candles"]
